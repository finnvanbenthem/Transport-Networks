# 4. Run the assignment
#     (od_df was produced befre)
# ------------------------------------------------------------------
link_loads, path_flows = passenger_assignment(
    od_df, k_paths_dict,
    beta_I=beta_I, beta_W=beta_W, beta_T=beta_T
)

print(f"Assigned demand on {len(link_loads):,} directed edges.")

