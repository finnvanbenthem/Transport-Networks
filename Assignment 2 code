import pickle
import numpy as np
import pandas as pd
from collections import Counter
from pathlib import Path

# ------------------------------------------------------------------
# 1. Load the pre-computed k-shortest-path catalogue  (k = 3)
# ------------------------------------------------------------------
with open(Path("gtc_results.pkl"), "rb") as fh:
    k_paths_dict = pickle.load(fh)          # nested dict: k_paths_dict[o][d] = [path1, path2, path3]

# ------------------------------------------------------------------
# 2. Behavioural parameters  (logit utility function)
# ------------------------------------------------------------------
beta_I = -0.10                    # in-vehicle time disutility  (min⁻¹)   –– given
waiting_penalty   = 2.5           # passengers feel waiting ≈2–3× worse than IVT   :contentReference[oaicite:0]{index=0}
transfer_equiv_IVT = 10           # one transfer ≈ 10 min of IVT disutility          :contentReference[oaicite:1]{index=1}

beta_W = waiting_penalty   * beta_I     # → -0.25
beta_T = transfer_equiv_IVT * beta_I     # → -1.00

# ------------------------------------------------------------------
# 3. Logit assignment helper
# ------------------------------------------------------------------
def passenger_assignment(od_matrix, k_paths, beta_I, beta_W, beta_T):
    """
    Probabilistic assignment of OD demand to network links
    using a multinomial-logit choice over the k = 3 shortest paths.
    
    Returns
    -------
    link_loads : Counter  {(u, v): passengers}
    path_flows : dict     {o: {d: [ {..., flow=<pax>} ]}}
    """
    # make an iterable (o, d, demand)
    if isinstance(od_matrix, dict):
        od_iter = [(o, d, flow)
                   for o, dests in od_matrix.items()
                   for d, flow in dests.items() if flow > 0]
    else:                                   # assume DataFrame with cols origin, destination, demand
        od_iter = od_matrix.itertuples(index=False, name=None)
    
    link_loads = Counter()
    path_flows = {}
    
    for o, d, Q in od_iter:
        # skip pairs w/o a path catalogue
        if Q <= 0 or o not in k_paths or d not in k_paths[o]:
            continue
        
        paths = k_paths[o][d]               # list of ≤3 dicts
        
        # utility & choice prob for every path
        U      = np.array([ beta_I*p['in_vehicle']
                            + beta_W*p['waiting_time']
                            + beta_T*p['n_transfers']        for p in paths ])
        exp_U  = np.exp(U - U.max())        # numeric stability
        probs  = exp_U / exp_U.sum()
        
        # store flows
        path_flows.setdefault(o, {})[d] = []
        for p_dict, P in zip(paths, probs):
            flow = Q * P                    # pax choosing this path
            path_flows[o][d].append({**p_dict, "flow": flow})
            
            # add to directed-edge counters
            for u, v in zip(p_dict["path"][:-1], p_dict["path"][1:]):
                link_loads[(u, v)] += flow
    
    return link_loads, path_flows

