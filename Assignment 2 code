# Step 2: Build OD matrix using gravitational model
stations = list(closeness.keys())
od_matrix = pd.DataFrame(index=stations, columns=stations).fillna(0.0)

for i in stations:
    for j in stations:
        if i == j:
            continue
        try:
            t_ij = gtc[i][j][0]['in_vehicle']
        except (KeyError, IndexError):
            continue  # no valid path

        f_ij = alpha * np.exp(-beta * t_ij)

        # Compute the denominator once per i
        denom = sum(q[k] * alpha * np.exp(-beta * gtc[i][k][0]['in_vehicle'])
